rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /portfolio_items/{itemId} {
      allow read, write: if true;
    }
    match /studio_config/{configId} {
      allow read, write: if true;
    }
    match /studio_categories/{categoryId} {
      allow read, write: if true;
    }
    match /client_galleries/{galleryId} {
      allow read, write: if true;
    }
    match /activity_notifications/{notificationId} {
      allow read, write: if true;
    }
    match /discovery_sessions/{sessionId} {
      allow read, write: if true;
    }
    match /studio_announcements/{announcementId} {
      allow read, write: if true;
    }
    match /client_conversations/{conversationId} {
      allow read, write: if true;
    }
    match /bot_knowledge/{knowledgeId} {
      allow read, write: if true;
    }
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
